{
  "Routes": [
    // 1. Luồng dành cho Học viên (Chuyển tiếp đến API User)
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7076
        }
      ],
      "UpstreamPathTemplate": "/user-api/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    },
    // 2. Luồng dành cho Lễ tân/Admin (Chuyển tiếp đến API Admin)
    {
      "DownstreamPathTemplate": "/api/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 44306
        }
      ],
      "UpstreamPathTemplate": "/admin-api/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    },
    // LUONG API CORE
    {
      "DownstreamPathTemplate": "/api/xac-thuc/{everything}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 7159
        }
      ],
      "UpstreamPathTemplate": "/core-api/xac-thuc/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7009"
  }
}
